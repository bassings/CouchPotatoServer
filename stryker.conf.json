{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "JS mutation testing over the extracted UI logic. The supported command runner avoids Stryker10/Vitest5 zero-test name filtering (https://github.com/stryker-mutator/stryker-js/issues/6210) and starts a fresh process per mutant. These pure-function tests need no DOM; the normal full gate retains jsdom. Scores remain informational.",
  "packageManager": "npm",
  "testRunner": "command",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "mutate": [
    "couchpotato/static/scripts/ui/**/*.{js,ts}"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    ".venv",
    "venv",
    "mutants",
    ".mutmut-cache",
    ".codex",
    ".claude",
    "test_data",
    "data",
    "config",
    ".config",
    ".e2e-*"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/stryker.html"
  },
  "commandRunner": {
    "command": "npx vitest run tests/unit/ui --maxWorkers 1 --environment node"
  },
  "disableTypeChecks": "**/*.{js,ts,jsx,tsx,mjs,cjs,mts,cts}"
}
